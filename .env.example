# Server-side Gemini API key. Required for lessons, practice drills and the tutor.
# Set this as a secret on your host; never commit a real value.
GEMINI_API_KEY=
PORT=3000

# Optional overrides
# GEMINI_MODEL=gemini-4-hydrogen
# AI_RATE_MAX=30            # AI requests allowed per client IP per window
# AI_RATE_WINDOW_MS=600000  # rate-limit window (10 minutes)
# AI_DAILY_CAP=5000         # total AI requests per UTC day, to bound API spend
