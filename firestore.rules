rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerified() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'bmutunga794@gmail.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isStringListBounded(listVal, maxLen) {
      return listVal is list && listVal.size() <= maxLen && (listVal.size() == 0 || listVal[0] is string);
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid', 'email', 'name', 'accountType', 'preferredGrade', 'lp', 'level', 'streak',
          'lastLogin', 'questsLastGenerated', 'audioEnabled', 'unlockedAvatarItems',
          'equippedAvatarItems', 'badges', 'completedModuleIds', 'completedCapstones',
          'solvedCtfFlags', 'joinedClassIds', 'parentInviteCode', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'email', 'name', 'accountType', 'preferredGrade', 'lp', 'level', 'streak',
          'lastLogin', 'questsLastGenerated', 'audioEnabled', 'unlockedAvatarItems',
          'equippedAvatarItems', 'badges', 'completedModuleIds', 'completedCapstones',
          'solvedCtfFlags', 'joinedClassIds', 'parentInviteCode', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 200
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 40
        && data.accountType in ['student', 'teacher', 'parent']
        && data.preferredGrade is int && data.preferredGrade >= 1 && data.preferredGrade <= 9
        && data.lp is int && data.lp >= 0 && data.lp <= 10000000
        && data.level is int && data.level >= 1 && data.level <= 200
        && data.streak is int && data.streak >= 0 && data.streak <= 10000
        && data.lastLogin is string && data.lastLogin.size() <= 32
        && data.questsLastGenerated is string && data.questsLastGenerated.size() <= 32
        && data.audioEnabled is bool
        && isStringListBounded(data.unlockedAvatarItems, 20)
        && data.equippedAvatarItems is map && data.equippedAvatarItems.keys().size() <= 5
        && isStringListBounded(data.badges, 40)
        && isStringListBounded(data.completedModuleIds, 900)
        && isStringListBounded(data.completedCapstones, 40)
        && isStringListBounded(data.solvedCtfFlags, 40)
        && isStringListBounded(data.joinedClassIds, 30)
        && data.parentInviteCode is string && data.parentInviteCode.size() <= 32
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidClassroom(data) {
      return data.keys().hasAll([
          'id', 'teacherUid', 'teacherName', 'name', 'grade', 'joinCode',
          'assignedModuleIds', 'lockedExamModuleIds', 'allowRetakes', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'teacherUid', 'teacherName', 'name', 'grade', 'joinCode',
          'assignedModuleIds', 'lockedExamModuleIds', 'allowRetakes', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.teacherUid)
        && data.teacherName is string && data.teacherName.size() >= 1 && data.teacherName.size() <= 60
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.grade is int && data.grade >= 1 && data.grade <= 9
        && data.joinCode is string && data.joinCode.size() >= 4 && data.joinCode.size() <= 24 && data.joinCode.matches('^[A-Z0-9\\-]+$')
        && isStringListBounded(data.assignedModuleIds, 30)
        && isStringListBounded(data.lockedExamModuleIds, 30)
        && data.allowRetakes is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidClassroomInvite(data) {
      return data.keys().hasAll(['joinCode', 'classId', 'teacherUid', 'classroomName', 'grade', 'createdAt'])
        && data.keys().hasOnly(['joinCode', 'classId', 'teacherUid', 'classroomName', 'grade', 'createdAt'])
        && data.joinCode is string && data.joinCode.size() >= 4 && data.joinCode.size() <= 24 && data.joinCode.matches('^[A-Z0-9\\-]+$')
        && isValidId(data.classId)
        && isValidId(data.teacherUid)
        && data.classroomName is string && data.classroomName.size() >= 1 && data.classroomName.size() <= 80
        && data.grade is int && data.grade >= 1 && data.grade <= 9
        && data.createdAt is timestamp;
    }

    function isValidClassMember(data) {
      return data.keys().hasAll([
          'studentUid', 'classId', 'teacherUid', 'joinCode', 'studentName', 'grade',
          'lp', 'level', 'streak', 'completedModulesCount', 'completedModuleIds',
          'examScores', 'completedCapstones', 'solvedCtfFlags', 'badgesCount', 'joinedAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'studentUid', 'classId', 'teacherUid', 'joinCode', 'studentName', 'grade',
          'lp', 'level', 'streak', 'completedModulesCount', 'completedModuleIds',
          'examScores', 'completedCapstones', 'solvedCtfFlags', 'badgesCount', 'joinedAt', 'updatedAt'
        ])
        && isValidId(data.studentUid)
        && isValidId(data.classId)
        && isValidId(data.teacherUid)
        && data.joinCode is string && data.joinCode.size() >= 4 && data.joinCode.size() <= 24
        && data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 40
        && data.grade is int && data.grade >= 1 && data.grade <= 9
        && data.lp is int && data.lp >= 0 && data.lp <= 10000000
        && data.level is int && data.level >= 1 && data.level <= 200
        && data.streak is int && data.streak >= 0 && data.streak <= 10000
        && data.completedModulesCount is int && data.completedModulesCount >= 0 && data.completedModulesCount <= 900
        && isStringListBounded(data.completedModuleIds, 900)
        && data.examScores is map && data.examScores.keys().size() <= 200
        && isStringListBounded(data.completedCapstones, 40)
        && isStringListBounded(data.solvedCtfFlags, 40)
        && data.badgesCount is int && data.badgesCount >= 0 && data.badgesCount <= 40
        && data.joinedAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidParentLink(data) {
      return data.keys().hasAll([
          'linkCode', 'studentUid', 'parentUid', 'studentName', 'grade', 'lp', 'level',
          'streak', 'completedModulesCount', 'completedModuleIds', 'examScores',
          'completedCapstones', 'solvedCtfFlags', 'badges', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'linkCode', 'studentUid', 'parentUid', 'studentName', 'grade', 'lp', 'level',
          'streak', 'completedModulesCount', 'completedModuleIds', 'examScores',
          'completedCapstones', 'solvedCtfFlags', 'badges', 'createdAt', 'updatedAt'
        ])
        && data.linkCode is string && data.linkCode.size() >= 6 && data.linkCode.size() <= 32 && data.linkCode.matches('^[A-Z0-9\\-]+$')
        && isValidId(data.studentUid)
        && data.parentUid is string && data.parentUid.size() <= 128
        && data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 40
        && data.grade is int && data.grade >= 1 && data.grade <= 9
        && data.lp is int && data.lp >= 0 && data.lp <= 10000000
        && data.level is int && data.level >= 1 && data.level <= 200
        && data.streak is int && data.streak >= 0 && data.streak <= 10000
        && data.completedModulesCount is int && data.completedModulesCount >= 0 && data.completedModulesCount <= 900
        && isStringListBounded(data.completedModuleIds, 900)
        && data.examScores is map && data.examScores.keys().size() <= 200
        && isStringListBounded(data.completedCapstones, 40)
        && isStringListBounded(data.solvedCtfFlags, 40)
        && isStringListBounded(data.badges, 40)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Admin registry (read-only by owner/admin)
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list, write: if false;
    }

    // 1. User profiles (PII strictly owner-isolated)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create: if isVerified() && isValidId(userId) && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(userId) && isValidUserProfile(incoming()) && (
        isAdmin() ||
        (isOwner(userId)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'email', 'name', 'accountType', 'preferredGrade', 'lp', 'level', 'streak',
            'lastLogin', 'questsLastGenerated', 'audioEnabled', 'unlockedAvatarItems',
            'equippedAvatarItems', 'badges', 'completedModuleIds', 'completedCapstones',
            'solvedCtfFlags', 'joinedClassIds', 'parentInviteCode', 'updatedAt'
          ]))
      );
      allow delete: if isAdmin();
    }

    // 2. Teacher-managed classrooms
    match /classrooms/{classId} {
      allow get: if isSignedIn() && isValidId(classId) && (
        existing().teacherUid == request.auth.uid ||
        exists(/databases/$(database)/documents/classrooms/$(classId)/members/$(request.auth.uid)) ||
        isAdmin()
      );
      allow list: if isSignedIn() && resource.data.teacherUid == request.auth.uid;
      allow create: if isVerified() && isValidId(classId)
        && isValidClassroom(incoming())
        && incoming().id == classId
        && incoming().teacherUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(classId) && isValidClassroom(incoming()) && (
        isAdmin() ||
        (existing().teacherUid == request.auth.uid
          && incoming().id == existing().id
          && incoming().teacherUid == existing().teacherUid
          && incoming().joinCode == existing().joinCode
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'teacherName', 'name', 'grade', 'assignedModuleIds', 'lockedExamModuleIds', 'allowRetakes', 'updatedAt'
          ]))
      );
      allow delete: if isVerified() && isValidId(classId) && (existing().teacherUid == request.auth.uid || isAdmin());

      // 3. Classroom members subcollection (Master Gate)
      match /members/{studentUid} {
        allow get: if isSignedIn() && isValidId(classId) && isValidId(studentUid) && (
          studentUid == request.auth.uid ||
          get(/databases/$(database)/documents/classrooms/$(classId)).data.teacherUid == request.auth.uid ||
          isAdmin()
        );
        allow list: if isSignedIn() && (
          resource.data.studentUid == request.auth.uid ||
          resource.data.teacherUid == request.auth.uid
        );
        allow create: if isVerified() && isValidId(classId) && isValidId(studentUid)
          && studentUid == request.auth.uid
          && isValidClassMember(incoming())
          && incoming().studentUid == request.auth.uid
          && incoming().classId == classId
          && exists(/databases/$(database)/documents/classrooms/$(classId))
          && get(/databases/$(database)/documents/classrooms/$(classId)).data.joinCode == incoming().joinCode
          && get(/databases/$(database)/documents/classrooms/$(classId)).data.teacherUid == incoming().teacherUid
          && incoming().joinedAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerified() && isValidId(classId) && isValidId(studentUid)
          && isValidClassMember(incoming())
          && exists(/databases/$(database)/documents/classrooms/$(classId))
          && (
            isAdmin() ||
            (studentUid == request.auth.uid
              && incoming().studentUid == existing().studentUid
              && incoming().classId == existing().classId
              && incoming().teacherUid == existing().teacherUid
              && incoming().joinCode == existing().joinCode
              && incoming().joinedAt == existing().joinedAt
              && incoming().updatedAt == request.time
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'studentName', 'grade', 'lp', 'level', 'streak', 'completedModulesCount',
                'completedModuleIds', 'examScores', 'completedCapstones', 'solvedCtfFlags',
                'badgesCount', 'updatedAt'
              ]))
          );
        allow delete: if isVerified() && isValidId(classId) && isValidId(studentUid) && (
          studentUid == request.auth.uid ||
          get(/databases/$(database)/documents/classrooms/$(classId)).data.teacherUid == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // 4. Join-code resolution (exact get lookup only, zero PII, no listing)
    match /classroomInvites/{joinCode} {
      allow get: if isSignedIn() && isValidId(joinCode);
      allow list: if false;
      allow create: if isVerified() && isValidId(joinCode)
        && isValidClassroomInvite(incoming())
        && incoming().joinCode == joinCode
        && incoming().teacherUid == request.auth.uid
        && existsAfter(/databases/$(database)/documents/classrooms/$(incoming().classId))
        && getAfter(/databases/$(database)/documents/classrooms/$(incoming().classId)).data.teacherUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/classrooms/$(incoming().classId)).data.joinCode == joinCode
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isVerified() && isValidId(joinCode) && (existing().teacherUid == request.auth.uid || isAdmin());
    }

    // 5. Parent-Student progress bridge (zero PII)
    match /parentLinks/{linkCode} {
      allow get: if isSignedIn() && isValidId(linkCode) && (
        existing().studentUid == request.auth.uid ||
        existing().parentUid == '' ||
        existing().parentUid == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.studentUid == request.auth.uid ||
        resource.data.parentUid == request.auth.uid
      );
      allow create: if isVerified() && isValidId(linkCode)
        && isValidParentLink(incoming())
        && incoming().linkCode == linkCode
        && incoming().studentUid == request.auth.uid
        && incoming().parentUid == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(linkCode) && isValidParentLink(incoming()) && (
        isAdmin() ||
        // Action: Student updates progress snapshot
        (existing().studentUid == request.auth.uid
          && incoming().linkCode == existing().linkCode
          && incoming().studentUid == existing().studentUid
          && incoming().parentUid == existing().parentUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'studentName', 'grade', 'lp', 'level', 'streak', 'completedModulesCount',
            'completedModuleIds', 'examScores', 'completedCapstones', 'solvedCtfFlags',
            'badges', 'updatedAt'
          ])) ||
        // Action: Parent claims unclaimed invite code
        (existing().parentUid == ''
          && incoming().parentUid == request.auth.uid
          && incoming().linkCode == existing().linkCode
          && incoming().studentUid == existing().studentUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['parentUid', 'updatedAt']))
      );
      allow delete: if isVerified() && isValidId(linkCode) && (
        existing().studentUid == request.auth.uid ||
        existing().parentUid == request.auth.uid ||
        isAdmin()
      );
    }
  }
}
