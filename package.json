{
  "name": "voi-hub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "start": "tsx server.ts --prod",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/server*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "lint": "eslint firestore.rules",
    "test:rules": "firebase emulators:exec --config firebase.test.json --project demo-voihub-rules --only firestore \"tsx --test tests/firestoreRules.test.ts\""
  },
  "dependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@google/genai": "^3.6.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "^5.0.6",
    "eslint": "^10.15.0",
    "express": "^5.3.0",
    "firebase": "^13.4.0",
    "framer-motion": "11.2.10",
    "lucide-react": "^1.81.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
